# Keep the build context small and keep secrets out of the image.

# --- version control and CI ---------------------------------------------------
.git
.gitignore
.github

# --- installed locally, installed again inside the build ----------------------
node_modules
vendor

# --- secrets: never baked into an image layer ---------------------------------
.env
.env.*

# --- rebuilt inside the image ------------------------------------------------
public/build
public/hot

# --- test and static-analysis tooling (not needed at runtime) -----------------
tests
phpstan.neon
pint.json
.phpunit.result.cache

# --- generated IDE helpers ----------------------------------------------------
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# --- runtime artefacts --------------------------------------------------------
storage/logs/*
storage/app/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# --- OS noise -----------------------------------------------------------------
.DS_Store
*.md
