# Environment for the local Docker stack (read by docker-compose.yml).
#
# This file is NOT shipped inside the image — .dockerignore excludes .env*.
# For production, set the same keys in your platform's environment settings and
# provide your own APP_KEY. Never reuse the key below.
#
# URL inside is http://localhost:8090 (host) -> 8080 (container), not
# https://multi-store.test. The Valet host only resolves on the Mac itself.

APP_NAME="Multi Store"
APP_ENV=local
APP_KEY=base64:1bBBesX8lzWMpcPSynzGoCaRM9F0h+bG9BbgGkHgWpo=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Container logs land in `docker compose logs`.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_* are set in docker-compose.yml, which points at the `db` service.
DB_CONNECTION=pgsql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail is delivered to the Mailpit container: read it at http://localhost:8026
MAIL_MAILER=smtp
# "mail" is the compose service name — that is what Docker DNS resolves.
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
# Literal on purpose: compose does not interpolate one env_file key inside another.
MAIL_FROM_NAME="Multi Store"

# M-Pesa callback. Safaricom must reach this URL over the public internet.
#
# Default = the container itself. Outbound STK pushes work, but the confirmation
# can never come back. To receive callbacks:
#   1. ngrok http 8090
#   2. set this line to <the ngrok https url>/api/mpesa/callback
#   3. docker compose up -d
MPESA_CALLBACK_URL=http://localhost:8090/api/mpesa/callback

# Seeding is opt-in. Seed once with:
#   docker compose exec app php artisan db:seed --force
RUN_SEEDERS=false
