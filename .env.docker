# Environment for the local Docker stack (read by docker-compose.yml).
#
# This file is NOT shipped inside the image — .dockerignore excludes .env*.
# For production, set the same keys in your platform's environment settings and
# provide your own APP_KEY. Never reuse the key below.
#
# URL inside the stack is http://localhost:8080, not https://multi-store.test.
# The Valet host only resolves on the Mac itself, not inside the container.

APP_NAME="Multi Store"
APP_ENV=local
APP_KEY=base64:1bBBesX8lzWMpcPSynzGoCaRM9F0h+bG9BbgGkHgWpo=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Container logs land in `docker compose logs`.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_* are set in docker-compose.yml, which points at the `db` service.
DB_CONNECTION=pgsql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# No SMTP server locally: mail is written to the log instead of failing.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
# Literal on purpose: compose does not interpolate one env_file key inside another.
MAIL_FROM_NAME="Multi Store"

# Seeding is opt-in. Seed once with:
#   docker compose exec app php artisan db:seed --force
RUN_SEEDERS=false
